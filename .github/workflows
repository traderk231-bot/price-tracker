name: Daily Price Check

on:
  schedule:
    # 每日UTC 13:00 run一次 (即多倫多EST時間早上8am,夏令時間就係早上9am)
    - cron: "0 13 * * *"
  workflow_dispatch: {}   # 俾你可以喺GitHub網頁度手動撳「Run workflow」嚟test

permissions:
  contents: write   # 要寫返 price_history.json 落個repo

jobs:
  check-prices:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: |
          pip install -r requirements.txt
          playwright install --with-deps chromium

      - name: Run scraper
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
        run: python scraper.py

      - name: Commit updated price history
        run: |
          git config user.name "price-monitor-bot"
          git config user.email "actions@users.noreply.github.com"
          git add price_history.json
          git diff --quiet --cached || git commit -m "Update price history $(date -u +%Y-%m-%d)"
          git push
